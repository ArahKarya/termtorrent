{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "termtorrent",
  "version": "0.1.0",
  "identifier": "dev.arahkarya.termtorrent",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "termtorrent",
        "width": 1040,
        "height": 680,
        "minWidth": 720,
        "minHeight": 420,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#080b0a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Lightweight terminal-styled torrent client",
    "longDescription": "termtorrent is a minimal BitTorrent client with a terminal-inspired interface, built on librqbit and Tauri.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
